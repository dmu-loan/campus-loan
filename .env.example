# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요. (.env 는 커밋 금지)
#   cp .env.example .env

# ===== MySQL (docker-compose 와 Spring 이 함께 사용) =====
DB_NAME=campus_loan
DB_USERNAME=campus
DB_PASSWORD=change-me
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root

# ===== 애플리케이션 =====
# 마스터 관리자 계정 비밀번호 (필수)
ADMIN_PASSWORD=change-me
# 당직표 Google Sheets 문서 ID
SHEETS_ID=
# 비공개 시트일 때 서비스 계정 JSON 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=
